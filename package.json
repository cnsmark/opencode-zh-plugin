{
  "name": "opencode-zh-plugin",
  "version": "0.1.7",
  "description": "Chinese locale plugin for OpenCode — AI reply localization + TUI slot replacement + slash commands",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mike652638/opencode-zh-plugin.git"
  },
  "homepage": "https://github.com/mike652638/opencode-zh-plugin#readme",
  "keywords": ["opencode", "plugin", "i18n", "chinese", "zh-CN", "zh-TW", "localization"],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "config": {
        "enabled": true,
        "locale": "zh-CN",
        "systemPrompt": true,
        "tuiSlots": true,
        "commands": true
      }
    },
    "./server": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "config": {
        "enabled": true,
        "locale": "zh-CN",
        "systemPrompt": true,
        "tuiSlots": true,
        "commands": true
      }
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "opencode": ">=1.18.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.19.2",
    "@opencode/plugin": "2.0.30",
    "@opencode/theme": "2.0.30",
    "@opentui/solid": "^0.5.17",
    "solid-js": "^1.9.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.0",
    "@opentui/core": ">=0.4.3",
    "@opentui/solid": ">=0.4.3",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
